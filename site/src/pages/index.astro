---
import Base from "../layouts/Base.astro";
import CarteOeuvre from "../components/CarteOeuvre.astro";
import { toutesLesOeuvres, tousLesArtistes } from "../lib/oeuvres";

const oeuvres = toutesLesOeuvres();
const artistes = tousLesArtistes();
const enAvant = oeuvres.filter((o) => o.enAvant && o.statut !== "vendue");
const vitrine = (enAvant.length > 0 ? enAvant : oeuvres).slice(0, 8);
const disponibles = oeuvres.filter((o) => o.statut === "disponible").length;
const premiereImage = vitrine.find((o) => o.images.length > 0)?.images[0];
---

<Base
  titre="Lithographies originales signées et numérotées — collection privée, Paris"
  description={`Collection privée de ${disponibles} lithographies originales, toutes signées au crayon et numérotées, en feuilles et en état neuf. ${artistes.map((a) => a.nom).join(", ")}.`}
  image={premiereImage}
>
  <div class="enveloppe">
    <section class="section">
      <p class="surtitre">Collection privée — Paris</p>
      <h1>Lithographies originales<br />signées et numérotées</h1>
      <p class="chapeau">
        Une collection constituée auprès d'éditeurs d'art français entre les années 1970 et 1990.
        Chaque estampe est signée au crayon par l'artiste, numérotée, et accompagnée de son
        certificat d'authenticité. Toutes sont restées en feuilles, à plat, jamais encadrées.
      </p>
      <p style="margin-top:2rem">
        <a class="bouton" href="/catalogue">Voir le catalogue</a>
      </p>
    </section>

    <section class="section">
      <h2>Une sélection</h2>
      <div class="grille">
        {vitrine.map((o, i) => <CarteOeuvre oeuvre={o} prioritaire={i < 4} />)}
      </div>
    </section>

    <section class="section etroit">
      <h2>Pourquoi cette collection</h2>
      <p>
        Ce ne sont pas des reproductions. Chaque feuille est une estampe originale, tirée en
        édition limitée, signée à la main par l'artiste et numérotée au crayon. Le certificat
        d'authenticité d'origine accompagne chaque pièce.
      </p>
      <p>
        L'ensemble a été conservé à plat, à l'abri de la lumière, dans ses cartons d'origine. Les
        marges sont intactes, jamais massicotées ; aucune feuille n'a été montée sous verre. L'état
        est celui du jour du tirage.
      </p>
    </section>

    <section class="section">
      <h2>Les artistes</h2>
      <div class="grille">
        {
          artistes.map((a) => (
            <a class="carte" href={`/artiste/${a.slug}`}>
              <span class="carte-artiste">{a.nom}</span>
              <span class="carte-titre">
                {a.disponibles} œuvre{a.disponibles > 1 ? "s" : ""} disponible
                {a.disponibles > 1 ? "s" : ""}
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Base>
